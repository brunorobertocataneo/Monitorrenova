<mxCell id="conceptNote" value="Modelo conceitual inclui elementos de consulta, importação, aprovação e revisão do roteiro da professora. Herança de Analista/Gestor é conceitual (NÃO há alegação de herança PHP dessas entidades). O diagrama 03 mostra classes PHP reais." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="1110" width="645" height="178" as="geometry"/></mxCell>
