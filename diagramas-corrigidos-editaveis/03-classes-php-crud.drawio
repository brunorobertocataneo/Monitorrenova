<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device" pages="1">
  <diagram id="MR-APRES-03" name="03 - Classes PHP CRUD">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;UML de classes — CRUD e auditoria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="1-2" value="Componentes PHP atuais: tarefas.php e historico-tarefa.php (rotas), TarefaService, TarefaRepository e PDO. Eventos gravados em transacao." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="1-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«boundary / arquivo PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;public/tarefas.php&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Recebe GET / POST&lt;br/&gt;Exige sessão e verifica CSRF&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;criar / editar / arquivar&lt;br/&gt;renderiza views/tarefas.php&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="1-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;&amp;lt;&amp;lt;final&amp;gt;&amp;gt;&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaService&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;- repository: TarefaRepository {readonly}&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.45&quot;&gt;+ __construct(repository: TarefaRepository)&lt;br/&gt;+ validar(form: array): array&lt;br/&gt;+ criar(form: array, usuarioId: int): int&lt;br/&gt;+ atualizar(id: mixed, versao: mixed, form: array, usuarioId: int): void&lt;br/&gt;+ excluir(id: mixed, versao: mixed, usuarioId: int): void&lt;br/&gt;+ identificador(valor: mixed): int {static}&lt;br/&gt;- texto(valor: mixed, max: int, nome: string, min: int): string&lt;br/&gt;- exigirUsuario(usuarioId: int): void {static}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="160" width="475" height="480" as="geometry" />
        </mxCell>
        <mxCell id="1-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;&amp;lt;&amp;lt;final&amp;gt;&amp;gt;&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaRepository&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.4&quot;&gt;- db: PDO {readonly}&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.4&quot;&gt;+ __construct(db: PDO)&lt;br/&gt;+ criar(data: array, usuarioId: int): int&lt;br/&gt;+ listar(situacao: string, busca: string, pagina: int, limite: int): array&lt;br/&gt;+ buscar(id: int): ?array&lt;br/&gt;+ atualizar(id: int, versao: int, data: array, usuarioId: int): bool&lt;br/&gt;+ excluir(id: int, versao: int, usuarioId: int): bool&lt;br/&gt;+ historico(id: int): array&lt;br/&gt;+ buscarComArquivadas(id: int): ?array&lt;br/&gt;+ seguroExiste(id: int): bool&lt;br/&gt;+ segurosParaAssociar(): array&lt;br/&gt;- estado(id: int, travar: bool): ?array&lt;br/&gt;- registrarEvento(...): void&lt;br/&gt;- transacao(operacao: callable): mixed&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="970" y="150" width="570" height="565" as="geometry" />
        </mxCell>
        <mxCell id="1-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«biblioteca PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PDO&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Conexão MySQL&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ prepare(sql)&lt;br/&gt;+ beginTransaction()&lt;br/&gt;+ commit() / rollBack()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1130" y="760" width="325" height="180" as="geometry" />
        </mxCell>
        <mxCell id="1-7" value="chama" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0;entryY=0.80;" edge="1" parent="1" source="1-3" target="1-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-8" value="1 Service → 1 Repository (injeção)" style="endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.89;entryX=0;entryY=0.93;" edge="1" parent="1" source="1-4" target="1-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-9" value="depende de" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1-5" target="1-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-10" value="TarefaService valida regras. Repository possui transacao(), historico(), buscarComArquivadas() e registrarEvento(), com dependencia de PDO. Rotas PHP nao sao classes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="670" width="790" height="105" as="geometry" />
        </mxCell>
        <mxCell id="1-11" value="&lt;b&gt;Persistência:&lt;/b&gt; CREATE, UPDATE e arquivamento inserem evento auditável na mesma transação. Arquivamento é exclusão lógica (UPDATE excluido_em), e não DELETE físico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="825" width="940" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>