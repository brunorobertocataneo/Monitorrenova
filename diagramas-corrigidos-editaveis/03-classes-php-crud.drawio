<diagram id="MR-PHP-CRUD-2026" name="03 - Classes PHP tarefas">
<mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="MONITORRENOVA  |  CLASSES PHP — CRUD E AUDITORIA" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#123D49;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1630" height="52" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Visão de implementação. Rotas não são classes; dependências, assinaturas e transações conferidas no PHP da main." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#496C79;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="1630" height="52" as="geometry"/></mxCell>
<mxCell id="route" value="&lt;b&gt;«boundary / arquivo PHP»&lt;br/&gt;public/tarefas.php&lt;/b&gt;&lt;hr/&gt;POST criar / editar / arquivar&lt;br/&gt;GET listar / buscar&lt;br/&gt;Sessão e CSRF obrigatórios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FB;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="380" height="235" as="geometry"/></mxCell>
<mxCell id="svc" value="&lt;b&gt;«final» TarefaService&lt;/b&gt;&lt;hr/&gt;- repository: TarefaRepository {readonly}&lt;br/&gt;+ validar(form: array): array&lt;br/&gt;+ criar(form, usuarioId): int&lt;br/&gt;+ atualizar(id, versao, form, usuarioId): void&lt;br/&gt;+ excluir(id, versao, usuarioId): void" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="520" height="250" as="geometry"/></mxCell>
<mxCell id="repo" value="&lt;b&gt;«final» TarefaRepository&lt;/b&gt;&lt;hr/&gt;- db: PDO {readonly}&lt;br/&gt;+ criar(data, usuarioId): int&lt;br/&gt;+ listar(situacao, busca, pagina, limite): array&lt;br/&gt;+ buscar(id): ?array&lt;br/&gt;+ atualizar(id, versao, data, usuarioId): bool&lt;br/&gt;+ excluir(id, versao, usuarioId): bool&lt;br/&gt;+ historico(id): array&lt;br/&gt;+ buscarComArquivadas(id): ?array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FB;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="505" height="320" as="geometry"/></mxCell>
<mxCell id="pdo" value="&lt;b&gt;«biblioteca» PDO&lt;/b&gt;&lt;hr/&gt;+ prepare(sql)&lt;br/&gt;+ beginTransaction()&lt;br/&gt;+ commit()&lt;br/&gt;+ rollBack()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1150" y="675" width="505" height="160" as="geometry"/></mxCell>
<mxCell id="historyRoute" value="&lt;b&gt;«boundary / arquivo PHP»&lt;br/&gt;public/historico-tarefa.php&lt;/b&gt;&lt;hr/&gt;Consulta autenticada dos eventos, inclusive de tarefa arquivada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F6F1;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="dep1" value="chama" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="route" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="assoc" value="1 Service → 1 Repository (injeção)" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="svc" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pdoDep" value="depende de" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="repo" target="pdo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="historyDep" value="consultar histórico" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="historyRoute" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="repoNote" value="Todas as operações de escrita e o respectivo evento de histórico são transacionais no Repository. Arquivar = UPDATE lógico (não DELETE). A classe RegraTriagem e suas relações OO estão no diagrama 04." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="58" y="905" width="1560" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
