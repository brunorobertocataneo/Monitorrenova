<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device" pages="7">
  <diagram id="MR-APRES-03" name="03 - Classes PHP CRUD">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;UML de classes — CRUD e auditoria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="1-2" value="Modelagem dos componentes PHP reais: rota, Service, Repository e PDO. Entidades persistidas no diagrama relacional." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="1-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«boundary / arquivo PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;public/tarefas.php&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Recebe GET / POST&lt;br/&gt;Exige sessão e verifica CSRF&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;criar / editar / arquivar&lt;br/&gt;renderiza views/tarefas.php&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="1-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«classe final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaService&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;- repository: TarefaRepository&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ validar(form): array&lt;br/&gt;+ criar(form, usuarioId): int&lt;br/&gt;+ atualizar(id: mixed, versao: mixed, form: array, usuarioId: int): void&lt;br/&gt;+ excluir(id, versao, usuarioId): void&lt;br/&gt;+ identificador(valor): int {static}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="440" height="350" as="geometry" />
        </mxCell>
        <mxCell id="1-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«classe final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaRepository&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;- db: PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ criar(dados, usuarioId): int&lt;br/&gt;+ listar(situacao, busca, pagina, limite): array&lt;br/&gt;+ buscar(id): ?array&lt;br/&gt;+ atualizar(id, versao, dados, usuarioId): bool&lt;br/&gt;+ excluir(id, versao, usuarioId): bool&lt;br/&gt;+ historico(id): array&lt;br/&gt;+ buscarComArquivadas(id): ?array&lt;br/&gt;- registrarEvento(...): void&lt;br/&gt;- comTransacao(op): mixed&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="165" width="505" height="445" as="geometry" />
        </mxCell>
        <mxCell id="1-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«biblioteca PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PDO&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Conexão MySQL&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ prepare(sql)&lt;br/&gt;+ beginTransaction()&lt;br/&gt;+ commit() / rollBack()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1120" y="755" width="300" height="183" as="geometry" />
        </mxCell>
        <mxCell id="1-7" value="chama" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0;entryY=0.80;" edge="1" parent="1" source="1-3" target="1-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-8" value="1 Service → 1 Repository (injeção)" style="endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.89;entryX=0;entryY=0.93;" edge="1" parent="1" source="1-4" target="1-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-9" value="depende de" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1-5" target="1-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-10" value="&lt;b&gt;Notas de UML:&lt;/b&gt; public/tarefas.php é uma rota PHP, e não classe de domínio. O Service valida regras, o Repository usa PDO. Os objetos são recebidos via construtor (injeção de dependência)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="790" height="120" as="geometry" />
        </mxCell>
        <mxCell id="1-11" value="&lt;b&gt;Persistência:&lt;/b&gt; CREATE, UPDATE e arquivamento inserem evento auditável na mesma transação. Arquivamento é exclusão lógica (UPDATE excluido_em), e não DELETE físico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="810" width="900" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>