        </mxCell>
        <mxCell id="2-15" value="&lt;b&gt;Relacionamentos reais:&lt;/b&gt; o Simulador cria um ConjuntoRegrasTriagem e um ResultadoTriagem; Conjunto agrega instancias de RegraAvaliavel recebidas externamente; Resultado compoe LinhaResultadoTriagem criada internamente. O banco nao participa desse fluxo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
