        <mxCell id="2-14" value="&lt;b&gt;Polimorfismo:&lt;/b&gt; o simulador percorre as três regras com o mesmo método avaliar(). Cada implementação retorna um motivo ou null, mantendo a ordem conservadora." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="370" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="2-15" value="RegraAvaliavel é interface real em PHP; RegraTriagem é classe abstrata real. O simulador não envia mensagens e não altera o MySQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
