<mxCell id="title" value="MONITORRENOVA  |  POO REAL EM PHP" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#123D49;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1660" height="52" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Notação UML: realização de interface (tracejada + triângulo vazio), generalização (contínua), agregação (losango vazio), composição (losango cheio)." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#496C79;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="1660" height="52" as="geometry"/></mxCell>
<mxCell id="interface" value="&lt;b&gt;«interface» RegraAvaliavel&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro: array, contexto: array): ?string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="670" y="170" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="base" value="&lt;b&gt;«abstract» RegraTriagem&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro: array, contexto: array): ?string {abstract}&lt;br/&gt;+ normalizar(valor): string {static, final}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5F4;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="670" y="375" width="470" height="150" as="geometry"/></mxCell>
