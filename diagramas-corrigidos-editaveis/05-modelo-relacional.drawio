      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;Modelo relacional MySQL — tarefas e auditoria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="3-2" value="Tabelas implementadas: migrations 001 e 002. PK = chave primária; FK = chave estrangeira." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1590" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;usuario&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;login: VARCHAR(80)&lt;br/&gt;senha_hash: VARCHAR(255)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="245" width="335" height="230" as="geometry" />
        </mxCell>
        <mxCell id="3-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;seguro_mensal&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;competencia: CHAR(7)&lt;br/&gt;segurado: VARCHAR(255)&lt;br/&gt;vencimento: DATE&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="615" width="350" height="230" as="geometry" />
        </mxCell>
        <mxCell id="3-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;tarefa_acompanhamento&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;FK seguro_mensal_id: BIGINT NULL&lt;br/&gt;titulo: VARCHAR(120)&lt;br/&gt;descricao: VARCHAR(500)&lt;br/&gt;prioridade: ENUM&lt;br/&gt;situacao: ENUM&lt;br/&gt;vencimento: DATE NULL&lt;br/&gt;versao: INT&lt;br/&gt;FK criado_por / atualizado_por&lt;br/&gt;FK excluido_por: BIGINT NULL&lt;br/&gt;criado_em / atualizado_em / excluido_em&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="265" width="465" height="515" as="geometry" />
        </mxCell>
        <mxCell id="3-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;historico_tarefa_acompanhamento&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;FK tarefa_id: BIGINT&lt;br/&gt;FK usuario_id: BIGINT&lt;br/&gt;acao: ENUM&lt;br/&gt;versao: INT&lt;br/&gt;dados_antes: JSON NULL&lt;br/&gt;dados_depois: JSON NOT NULL&lt;br/&gt;criado_em: TIMESTAMP&lt;br/&gt;UNIQUE(tarefa_id, versao)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="310" width="425" height="430" as="geometry" />
        </mxCell>
        <mxCell id="3-7" value="criado_por / atualizado_por / excluido_por (3 FKs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.88;entryX=0;entryY=0.88;" edge="1" parent="1" source="3-3" target="3-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-8" value="tarefa 0..1 seguro; seguro 0..* tarefas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.42;entryX=0;entryY=0.94;" edge="1" parent="1" source="3-4" target="3-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-9" value="evento 1 tarefa; tarefa 0..* eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.88;entryX=0;entryY=0.89;" edge="1" parent="1" source="3-5" target="3-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-10" value="evento 1 autor; usuário 0..* eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.52;entryY=0;" edge="1" parent="1" source="3-3" target="3-6">
