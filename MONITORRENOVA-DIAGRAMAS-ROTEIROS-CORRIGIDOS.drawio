<diagram id="MR-PHP-CRUD-2026" name="03 - Classes PHP tarefas">
<mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="MONITORRENOVA  |  CLASSES PHP — CRUD E AUDITORIA" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#123D49;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1630" height="52" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Visão de implementação. Rotas não são classes; dependências, assinaturas e transações conferidas no PHP da main." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#496C79;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="1630" height="52" as="geometry"/></mxCell>
<mxCell id="route" value="&lt;b&gt;«boundary / arquivo PHP»&lt;br/&gt;public/tarefas.php&lt;/b&gt;&lt;hr/&gt;POST criar / editar / arquivar&lt;br/&gt;GET listar / buscar&lt;br/&gt;Sessão e CSRF obrigatórios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FB;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="380" height="235" as="geometry"/></mxCell>
<mxCell id="svc" value="&lt;b&gt;«final» TarefaService&lt;/b&gt;&lt;hr/&gt;- repository: TarefaRepository {readonly}&lt;br/&gt;+ validar(form: array): array&lt;br/&gt;+ criar(form, usuarioId): int&lt;br/&gt;+ atualizar(id, versao, form, usuarioId): void&lt;br/&gt;+ excluir(id, versao, usuarioId): void" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="540" y="250" width="520" height="250" as="geometry"/></mxCell>
<mxCell id="repo" value="&lt;b&gt;«final» TarefaRepository&lt;/b&gt;&lt;hr/&gt;- db: PDO {readonly}&lt;br/&gt;+ criar(data, usuarioId): int&lt;br/&gt;+ listar(situacao, busca, pagina, limite): array&lt;br/&gt;+ buscar(id): ?array&lt;br/&gt;+ atualizar(id, versao, data, usuarioId): bool&lt;br/&gt;+ excluir(id, versao, usuarioId): bool&lt;br/&gt;+ historico(id): array&lt;br/&gt;+ buscarComArquivadas(id): ?array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FB;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1150" y="250" width="505" height="320" as="geometry"/></mxCell>
<mxCell id="pdo" value="&lt;b&gt;«biblioteca» PDO&lt;/b&gt;&lt;hr/&gt;+ prepare(sql)&lt;br/&gt;+ beginTransaction()&lt;br/&gt;+ commit()&lt;br/&gt;+ rollBack()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1150" y="675" width="505" height="160" as="geometry"/></mxCell>
<mxCell id="historyRoute" value="&lt;b&gt;«boundary / arquivo PHP»&lt;br/&gt;public/historico-tarefa.php&lt;/b&gt;&lt;hr/&gt;Consulta autenticada dos eventos, inclusive de tarefa arquivada." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F6F1;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="440" height="150" as="geometry"/></mxCell>
<mxCell id="dep1" value="chama" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="route" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="assoc" value="1 Service → 1 Repository (injeção)" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="svc" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pdoDep" value="depende de" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="repo" target="pdo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="historyDep" value="consultar histórico" style="endArrow=open;endFill=0;dashed=1;strokeColor=#527486;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="historyRoute" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="repoNote" value="Todas as operações de escrita e o respectivo evento de histórico são transacionais no Repository. Arquivar = UPDATE lógico (não DELETE). A classe RegraTriagem e suas relações OO estão no diagrama 04." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="58" y="905" width="1560" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="MR-POO-CORR-2026" name="04 - POO interfaces heranca">
<mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1730" pageHeight="1410" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="MONITORRENOVA  |  POO REAL EM PHP" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#123D49;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1660" height="52" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Notação UML: realização de interface (tracejada + triângulo vazio), generalização (contínua), agregação (losango vazio), composição (losango cheio)." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#496C79;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="1660" height="52" as="geometry"/></mxCell>
<mxCell id="interface" value="&lt;b&gt;«interface» RegraAvaliavel&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro: array, contexto: array): ?string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="670" y="170" width="470" height="125" as="geometry"/></mxCell>
<mxCell id="base" value="&lt;b&gt;«abstract» RegraTriagem&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro: array, contexto: array): ?string {abstract}&lt;br/&gt;+ normalizar(valor): string {static, final}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5F4;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="670" y="375" width="470" height="150" as="geometry"/></mxCell>
<mxCell id="produto" value="&lt;b&gt;«final» RegraProduto&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro, contexto): ?string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="210" y="615" width="380" height="142" as="geometry"/></mxCell>
<mxCell id="situacao" value="&lt;b&gt;«final» RegraSituacao&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro, contexto): ?string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="690" y="615" width="380" height="142" as="geometry"/></mxCell>
<mxCell id="conferencia" value="&lt;b&gt;«final» RegraConferencia&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro, contexto): ?string" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1170" y="615" width="380" height="142" as="geometry"/></mxCell>
<mxCell id="implements" value="implements" style="endArrow=block;endFill=0;dashed=1;strokeColor=#0F766E;strokeWidth=2.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="base" target="interface"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inherit_produto" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="produto" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inherit_situacao" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="situacao" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="inherit_conferencia" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.3;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="conferencia" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="sim" value="&lt;b&gt;«final» SimuladorRenovacao&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguros, referencia): array&lt;br/&gt;+ janela(referencia): array {static}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="45" y="935" width="385" height="175" as="geometry"/></mxCell>
<mxCell id="conjunto" value="&lt;b&gt;«final» ConjuntoRegrasTriagem&lt;/b&gt;&lt;hr/&gt;- regras: list&amp;lt;RegraAvaliavel&amp;gt;&lt;br/&gt;+ avaliar(...): ?string&lt;br/&gt;+ contem(regra): bool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="505" y="935" width="375" height="175" as="geometry"/></mxCell>
<mxCell id="resultado" value="&lt;b&gt;«final» ResultadoTriagem&lt;/b&gt;&lt;hr/&gt;- linhas: list&amp;lt;LinhaResultadoTriagem&amp;gt;&lt;br/&gt;+ adicionar(dados): void&lt;br/&gt;+ linhas(): array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="985" y="935" width="335" height="175" as="geometry"/></mxCell>
<mxCell id="linha" value="&lt;b&gt;«final» LinhaResultadoTriagem&lt;/b&gt;&lt;hr/&gt;- dados: array {readonly}&lt;br/&gt;+ paraArray(): array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1370" y="935" width="320" height="175" as="geometry"/></mxCell>
<mxCell id="agrega" value="0..* regras" style="startArrow=diamond;startFill=0;endArrow=none;strokeColor=#A36B16;strokeWidth=2.4;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="conjunto" target="interface"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="compoe" value="0..* linhas" style="startArrow=diamond;startFill=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.4;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="resultado" target="linha"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="usa1" value="cria e utiliza" style="endArrow=open;endFill=0;dashed=1;strokeColor=#637A88;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sim" target="conjunto"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="usa2" value="cria resultado" style="endArrow=open;endFill=0;dashed=1;strokeColor=#637A88;strokeWidth=1.8;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sim" target="resultado"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="pooNote" value="A agregação recebe regras construídas externamente, com ciclo de vida próprio. A composição cria linhas internamente em ResultadoTriagem::adicionar(). São relações entre objetos PHP, não inferências de JOIN ou GROUP BY." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="1225" width="1605" height="104" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="MR-MODELO-RELACIONAL-2026" name="05 - Tarefas e auditoria MySQL">
<mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="MONITORRENOVA  |  MODELO RELACIONAL — TAREFAS E HISTÓRICO" style="text;html=1;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#123D49;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1650" height="52" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Recorte do esquema do sistema; PK, FKs, nulabilidade, histórico por versão. Não substitui o DER completo de competências/importação." style="text;html=1;align=left;verticalAlign=top;fontSize=15;fontColor=#496C79;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="78" width="1650" height="52" as="geometry"/></mxCell>
<mxCell id="usuario" value="&lt;b&gt;«tabela» usuario&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT UNSIGNED&lt;br/&gt;login: VARCHAR&lt;br/&gt;senha_hash: VARCHAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="55" y="230" width="390" height="185" as="geometry"/></mxCell>
<mxCell id="seguro" value="&lt;b&gt;«tabela» seguro_mensal&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT UNSIGNED&lt;br/&gt;competencia: CHAR(7)&lt;br/&gt;segurado: VARCHAR&lt;br/&gt;vencimento: DATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F6F7;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="55" y="625" width="390" height="195" as="geometry"/></mxCell>
<mxCell id="tarefa" value="&lt;b&gt;«tabela» tarefa_acompanhamento&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT UNSIGNED&lt;br/&gt;FK seguro_mensal_id: BIGINT NULL&lt;br/&gt;FK criado_por / atualizado_por: BIGINT&lt;br/&gt;FK excluido_por: BIGINT NULL&lt;br/&gt;titulo / descricao / prioridade / situacao&lt;br/&gt;versao: INT&lt;br/&gt;excluido_em: TIMESTAMP NULL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="590" y="290" width="510" height="340" as="geometry"/></mxCell>
<mxCell id="eventos" value="&lt;b&gt;«tabela» historico_tarefa_acompanhamento&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT UNSIGNED&lt;br/&gt;FK tarefa_id: BIGINT NOT NULL&lt;br/&gt;FK usuario_id: BIGINT NOT NULL&lt;br/&gt;acao: ENUM('criacao','edicao','arquivamento')&lt;br/&gt;versao: INT UNSIGNED NOT NULL&lt;br/&gt;dados_antes: JSON NULL&lt;br/&gt;dados_depois: JSON NOT NULL&lt;br/&gt;criado_em: TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF5FB;strokeColor=#426675;strokeWidth=1.6;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;fontSize=15;fontColor=#162F3A;" vertex="1" parent="1"><mxGeometry x="1200" y="290" width="485" height="350" as="geometry"/></mxCell>
<mxCell id="fk1" value="autoria: 3 FKs / 1 usuário por referência" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="usuario" target="tarefa"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fk2" value="seguro 0..* tarefas; tarefa 0..1 seguro" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="seguro" target="tarefa"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fk3" value="tarefa 0..* eventos; evento 1 tarefa" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="tarefa" target="eventos"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="fk4" value="autor de evento (1 usuário por evento)" style="endArrow=none;html=1;strokeColor=#718096;strokeWidth=1.6;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="usuario" target="eventos"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="idxNote" value="Integridade: UNIQUE(tarefa_id, versao) no histórico; FKs com ON DELETE RESTRICT; exclusão de tarefa é lógica e mantém histórico. O banco completo contém outras tabelas, views e mecanismos de competências." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="85" y="875" width="1510" height="110" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
