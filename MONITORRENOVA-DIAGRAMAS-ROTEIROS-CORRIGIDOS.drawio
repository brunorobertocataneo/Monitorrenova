<mxCell id="m10" value="11. mensagem ao analista" style="endArrow=open;dashed=1;strokeColor=#557988;strokeWidth=2;html=1;fontSize=14;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="530" y="980" as="sourcePoint"/><mxPoint x="175" y="980" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="seqNote" value="«alt» [arquivo válido e confirmação] → gravar lote integralmente em uma transação; [dados inválidos / cancelamento] → não gravar; [erro SQL] → rollback sem lote parcial. Fluxo conceitual exigido no roteiro, sem alegar teste completo das regras de importação." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E9;strokeColor=#CEAE74;fontColor=#62471F;align=left;verticalAlign=middle;spacing=12;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="1100" width="1730" height="105" as="geometry"/></mxCell>
