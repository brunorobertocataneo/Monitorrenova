  <diagram id="MR-APRES-02" name="02 - Classes conceituais">
    <mxGraphModel dx="1500" dy="1100" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x2" value="MonitorRenova — classes conceituais do domínio (modelo de análise)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=23;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1350" height="50" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="As caixas representam CONCEITOS do domínio, não classes PHP já implementadas. Relações embasadas no esquema relacional." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1370" height="50" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="Usuário&#xA;+ id: inteiro&#xA;+ login: texto&#xA;+ autenticar()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36576d;fontSize=17;align=left;verticalAlign=top;spacingLeft=14;spacingTop=14;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="75" y="175" width="330" height="195" as="geometry" />
        </mxCell>
        <mxCell id="x5" value="SeguroMensal&#xA;+ id: inteiro&#xA;+ competencia: ano-mês&#xA;+ segurado: texto&#xA;+ vencimento: data&#xA;+ consultar()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36576d;fontSize=17;align=left;verticalAlign=top;spacingLeft=14;spacingTop=14;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="175" width="335" height="205" as="geometry" />
        </mxCell>
        <mxCell id="x6" value="TarefaAcompanhamento&#xA;+ id: inteiro&#xA;+ titulo: texto&#xA;+ descricao: texto&#xA;+ prioridade: enum&#xA;+ situacao: enum&#xA;+ vencimento: data?&#xA;+ versao: inteiro&#xA;+ excluidoEm: data?&#xA;+ cadastrar()&#xA;+ atualizar()&#xA;+ arquivar()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36576d;fontSize=17;align=left;verticalAlign=top;spacingLeft=14;spacingTop=14;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="490" y="435" width="465" height="385" as="geometry" />
        </mxCell>
        <mxCell id="x7" value="EventoHistorico&#xA;+ id: inteiro&#xA;+ acao: enum&#xA;+ versao: inteiro&#xA;+ dadosAntes: JSON?&#xA;+ dadosDepois: JSON&#xA;+ criadoEm: data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#36576d;fontSize=17;align=left;verticalAlign=top;spacingLeft=14;spacingTop=14;spacingRight=8;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="865" width="365" height="225" as="geometry" />
        </mxCell>
        <mxCell id="x8" value="autoria de criação (1 tarefa → 1 usuário; usuário → 0..* tarefas)" style="endArrow=none;html=1;strokeColor=#36576d;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x4" target="x6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x9" value="seguro associado (tarefa 0..1; seguro 0..* tarefas)" style="endArrow=none;html=1;strokeColor=#36576d;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x5" target="x6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x10" value="histórico (evento 1 tarefa; tarefa 0..* eventos)" style="endArrow=none;html=1;strokeColor=#36576d;strokeWidth=1.6;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="x6" target="x7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x11" value="Associações de análise: a tarefa registra usuário criador e atualizador e pode registrar autor de arquivamento. Cada evento de histórico possui autoria própria. Não presumir composição de objetos PHP a partir de FKs." style="text;html=1;whiteSpace=wrap;strokeColor=#b1b9c1;fillColor=#f6f8fa;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="990" width="850" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="MR-APRES-03" name="03 - Classes PHP CRUD">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="1-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;UML de classes — CRUD e auditoria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="1-2" value="Modelagem dos componentes PHP reais: rota, Service, Repository e PDO. Entidades persistidas no diagrama relacional." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="1-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«boundary / arquivo PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;public/tarefas.php&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Recebe GET / POST&lt;br/&gt;Exige sessão e verifica CSRF&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;criar / editar / arquivar&lt;br/&gt;renderiza views/tarefas.php&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="340" height="260" as="geometry" />
        </mxCell>
        <mxCell id="1-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«classe final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaService&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;- repository: TarefaRepository&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ validar(form): array&lt;br/&gt;+ criar(form, usuarioId): int&lt;br/&gt;+ atualizar(id: mixed, versao: mixed, form: array, usuarioId: int): void&lt;br/&gt;+ excluir(id, versao, usuarioId): void&lt;br/&gt;+ identificador(valor): int {static}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="440" height="350" as="geometry" />
        </mxCell>
        <mxCell id="1-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«classe final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;TarefaRepository&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;- db: PDO&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ criar(dados, usuarioId): int&lt;br/&gt;+ listar(situacao, busca, pagina, limite): array&lt;br/&gt;+ buscar(id): ?array&lt;br/&gt;+ atualizar(id, versao, dados, usuarioId): bool&lt;br/&gt;+ excluir(id, versao, usuarioId): bool&lt;br/&gt;+ historico(id): array&lt;br/&gt;+ buscarComArquivadas(id): ?array&lt;br/&gt;- registrarEvento(...): void&lt;br/&gt;- comTransacao(op): mixed&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="165" width="505" height="445" as="geometry" />
        </mxCell>
        <mxCell id="1-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«biblioteca PHP»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PDO&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;Conexão MySQL&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ prepare(sql)&lt;br/&gt;+ beginTransaction()&lt;br/&gt;+ commit() / rollBack()&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1120" y="755" width="300" height="183" as="geometry" />
        </mxCell>
        <mxCell id="1-7" value="chama" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.85;entryX=0;entryY=0.80;" edge="1" parent="1" source="1-3" target="1-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-8" value="1 Service → 1 Repository (injeção)" style="endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.89;entryX=0;entryY=0.93;" edge="1" parent="1" source="1-4" target="1-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-9" value="depende de" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="1-5" target="1-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1-10" value="&lt;b&gt;Notas de UML:&lt;/b&gt; public/tarefas.php é uma rota PHP, e não classe de domínio. O Service valida regras, o Repository usa PDO. Os objetos são recebidos via construtor (injeção de dependência)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="790" height="120" as="geometry" />
        </mxCell>
        <mxCell id="1-11" value="&lt;b&gt;Persistência:&lt;/b&gt; CREATE, UPDATE e arquivamento inserem evento auditável na mesma transação. Arquivamento é exclusão lógica (UPDATE excluido_em), e não DELETE físico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="810" width="900" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="MR-APRES-04" name="04 - Classes POO e heranca">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;UML de classes — interface, herança e polimorfismo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1500" height="58" as="geometry" />
        </mxCell>
        <mxCell id="2-2" value="Implementação real em src/triagem e src/SimuladorRenovacao.php; as regras são somente leitura." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1490" height="45" as="geometry" />
        </mxCell>
        <mxCell id="2-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«interface»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RegraAvaliavel&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ avaliar(seguro: array, contexto: array): ?string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="625" y="140" width="350" height="150" as="geometry" />
        </mxCell>
        <mxCell id="2-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«abstract»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RegraTriagem&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ avaliar(seguro, contexto): ?string {abstract}&lt;br/&gt;+ normalizar(valor): string {static, final}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="625" y="365" width="350" height="190" as="geometry" />
        </mxCell>
        <mxCell id="2-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RegraProduto&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ avaliar(seguro, contexto): ?string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="85" y="715" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RegraSituacao&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ avaliar(seguro, contexto): ?string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="615" y="715" width="365" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2-7" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RegraConferencia&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ avaliar(seguro, contexto): ?string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1130" y="715" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="2-8" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«final»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;SimuladorRenovacao&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;+ janela(referencia): array {static}&lt;br/&gt;+ avaliar(seguros, referencia): array {static}&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1130" y="150" width="385" height="180" as="geometry" />
        </mxCell>
        <mxCell id="2-9" value="implements" style="endArrow=block;endFill=0;dashed=1;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2-4" target="2-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2-10" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2-5" target="2-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2-11" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2-6" target="2-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2-12" value="extends" style="endArrow=block;endFill=0;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2-7" target="2-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2-13" value="usa regras concretas" style="endArrow=open;endFill=0;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="2-8" target="2-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="2-14" value="&lt;b&gt;Polimorfismo:&lt;/b&gt; o simulador percorre as três regras com o mesmo método avaliar(). Cada implementação retorna um motivo ou null, mantendo a ordem conservadora." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="370" width="430" height="170" as="geometry" />
        </mxCell>
        <mxCell id="2-15" value="RegraAvaliavel é interface real em PHP; RegraTriagem é classe abstrata real. O simulador não envia mensagens e não altera o MySQL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="900" width="900" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="MR-APRES-05" name="05 - Modelo relacional MySQL">
    <mxGraphModel dx="1600" dy="1050" grid="1" gridSize="10" guides="1" connect="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;Modelo relacional MySQL — tarefas e auditoria&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="55" y="20" width="1600" height="58" as="geometry" />
        </mxCell>
        <mxCell id="3-2" value="Tabelas implementadas: migrations 001 e 002. PK = chave primária; FK = chave estrangeira." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1590" height="45" as="geometry" />
        </mxCell>
        <mxCell id="3-3" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;usuario&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;login: VARCHAR(80)&lt;br/&gt;senha_hash: VARCHAR(255)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="245" width="335" height="230" as="geometry" />
        </mxCell>
        <mxCell id="3-4" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;seguro_mensal&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;competencia: CHAR(7)&lt;br/&gt;segurado: VARCHAR(255)&lt;br/&gt;vencimento: DATE&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="615" width="350" height="230" as="geometry" />
        </mxCell>
        <mxCell id="3-5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;tarefa_acompanhamento&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;FK seguro_mensal_id: BIGINT NULL&lt;br/&gt;titulo: VARCHAR(120)&lt;br/&gt;descricao: VARCHAR(500)&lt;br/&gt;prioridade: ENUM&lt;br/&gt;situacao: ENUM&lt;br/&gt;vencimento: DATE NULL&lt;br/&gt;versao: INT&lt;br/&gt;FK criado_por / atualizado_por&lt;br/&gt;FK excluido_por: BIGINT NULL&lt;br/&gt;criado_em / atualizado_em / excluido_em&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF6ED;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="610" y="265" width="465" height="515" as="geometry" />
        </mxCell>
        <mxCell id="3-6" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;small&gt;«tabela»&lt;/small&gt;&lt;br/&gt;&lt;b style=&quot;font-size:17px&quot;&gt;historico_tarefa_acompanhamento&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;PK id: BIGINT&lt;br/&gt;FK tarefa_id: BIGINT&lt;br/&gt;FK usuario_id: BIGINT&lt;br/&gt;acao: ENUM&lt;br/&gt;versao: INT&lt;br/&gt;dados_antes: JSON NULL&lt;br/&gt;dados_depois: JSON NOT NULL&lt;br/&gt;criado_em: TIMESTAMP&lt;br/&gt;UNIQUE(tarefa_id, versao)&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;font-size:13px;line-height:1.55&quot;&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F1FF;strokeColor=#47617A;strokeWidth=2;align=left;verticalAlign=top;spacing=12;overflow=hidden;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="310" width="425" height="430" as="geometry" />
        </mxCell>
        <mxCell id="3-7" value="criado_por / atualizado_por / excluido_por (3 FKs)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.88;entryX=0;entryY=0.88;" edge="1" parent="1" source="3-3" target="3-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-8" value="tarefa 0..1 seguro; seguro 0..* tarefas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.42;entryX=0;entryY=0.94;" edge="1" parent="1" source="3-4" target="3-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-9" value="evento 1 tarefa; tarefa 0..* eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;strokeColor=#0F766E;strokeWidth=2.5;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.88;entryX=0;entryY=0.89;" edge="1" parent="1" source="3-5" target="3-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3-10" value="evento 1 autor; usuário 0..* eventos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=none;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=13;html=1;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;entryX=0.52;entryY=0;" edge="1" parent="1" source="3-3" target="3-6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="320" y="180" />
              <mxPoint x="1420" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="3-11" value="&lt;b&gt;Integridade:&lt;/b&gt; ON DELETE RESTRICT nas chaves estrangeiras, sem exclusão física. Cada tarefa pode ter vários eventos; o par (tarefa_id, versao) é único. JSON preserva estados antes/depois." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#CBD5E1;strokeWidth=1.3;align=left;verticalAlign=middle;spacing=15;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="470" y="900" width="1160" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
