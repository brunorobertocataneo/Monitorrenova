        <mxCell id="4-13" value="1. POST acao=criar + formulario" style="endArrow=classic;endFill=1;dashed=0;strokeColor=#1E506A;strokeWidth=2;html=1;fontSize=13;labelBackgroundColor=#FFFFFF;verticalLabelPosition=top;verticalAlign=bottom;" edge="1" parent="1">
