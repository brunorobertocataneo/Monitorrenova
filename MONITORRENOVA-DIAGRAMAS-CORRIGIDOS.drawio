        <mxCell id="4-1" value="&lt;b style=&quot;font-size:27px&quot;&gt;UML de sequência — cadastrar tarefa&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#18354E;" vertex="1" parent="1">
