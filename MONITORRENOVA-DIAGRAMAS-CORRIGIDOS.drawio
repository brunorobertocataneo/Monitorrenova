        <mxCell id="4-2" value="Caminho real do POST no CRUD, incluindo a transação que grava a tarefa e o primeiro evento." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#18354E;" vertex="1" parent="1">
