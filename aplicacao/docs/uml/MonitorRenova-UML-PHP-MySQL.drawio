95a;" vertex="1" parent="1"><mxGeometry x="967" y="780" width="12" height="10" as="geometry"/></mxCell><mxCell id="m8label" value="8. HTTP 303 → pasta do vendedor" style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;align=center;fontColor=#245642;" vertex="1" parent="1"><mxGeometry x="175" y="843" width="265" height="22" as="geometry"/></mxCell><mxCell id="m8line" value="" style="fillColor=#2d795a;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="170" y="870" width="275" height="1" as="geometry"/></mxCell><mxCell id="m8arrow" value="" style="shape=triangle;direction=east;fillColor=#2d795a;strokeColor=#2d795a;" vertex="1" parent="1"><mxGeometry x="162" y="865" width="12" height="10" as="geometry"/></mxCell><mxCell id="note" value="Fluxos alternativos: CSRF inválido → HTTP 403; versão desatualizada → conflito (409); erro de persistência → rollback. O sistema não envia WhatsApp." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7dd;strokeColor=#dbbe68;fontColor=#705412;fontSize=13;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="275" y="955" width="960" height="67" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dados" name="3 - Modelo relacional do status"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MonitorRenova | Modelo relacional — decisões e histórico" style="text;html=1;fillColor=none;strokeColor=none;fontSize=27;fontStyle=1;fontColor=#124d35;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1450" height="48" as="geometry"/></mxCell><mxCell id="subtitle" value="Tabela de origem não é alterada diretamente · seguro_dashboard é uma VIEW de consulta" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontColor=#5d7167;align=left;" vertex="1" parent="1"><mxGeometry x="38" y="70" width="1460" height="37" as="geometry"/></mxCell><mxCell id="usuarios" value="&lt;b&gt;usuario&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT&lt;br/&gt;login: VARCHAR&lt;br/&gt;senha_hash: VARCHAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e4f2ff;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="345" height="141" as="geometry"/></mxCell><mxCell id="estado" value="&lt;b&gt;sheet_sync_estado&lt;/b&gt;&lt;hr/&gt;PK id: INT&lt;br/&gt;competencia_ativa: CHAR(7)&lt;br/&gt;total_registros: INT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6f3;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="345" height="141" as="geometry"/></mxCell><mxCell id="fonte" value="&lt;b&gt;sheet_sync_registro_mensal&lt;/b&gt;&lt;hr/&gt;PK/índice por competência + linha_origem&lt;br/&gt;competencia, linha_origem&lt;br/&gt;segurado, vendedor, vencimento&lt;br/&gt;renovado, nao_vai_renovar, status_atual" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6f3;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="235" width="440" height="164" as="geometry"/></mxCell><mxCell id="manual" value="&lt;b&gt;seguro_status_manual&lt;/b&gt;&lt;hr/&gt;PK (competencia, linha_origem)&lt;br/&gt;renovado / nao_vai_renovar: TINYINT&lt;br/&gt;status_atual: VARCHAR(30)&lt;br/&gt;versao: INT&lt;br/&gt;FK atualizado_por → usuario.id&lt;br/&gt;atualizado_em: TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf8ee;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1055" y="170" width="440" height="210" as="geometry"/></mxCell><mxCell id="history" value="&lt;b&gt;seguro_status_manual_historico&lt;/b&gt;&lt;hr/&gt;PK id: BIGINT&lt;br/&gt;co