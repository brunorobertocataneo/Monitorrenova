ring" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6f3;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="160" y="585" width="315" height="104" as="geometry"/></mxCell><mxCell id="rs" value="&lt;b&gt;RegraSituacao&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro, contexto): ?string" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6f3;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="615" y="585" width="315" height="104" as="geometry"/></mxCell><mxCell id="rc" value="&lt;b&gt;RegraConferencia&lt;/b&gt;&lt;hr/&gt;+ avaliar(seguro, contexto): ?string" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6f3;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1070" y="585" width="315" height="104" as="geometry"/></mxCell><mxCell id="group" value="&lt;b&gt;ConjuntoRegrasTriagem&lt;/b&gt;&lt;hr/&gt;- regras: list&amp;amp;lt;RegraAvaliavel&amp;amp;gt;&lt;br/&gt;+ avaliar(seguro, contexto): ?string&lt;br/&gt;+ quantidade(): int&lt;br/&gt;+ contem(regra): bool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf8ee;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="255" width="345" height="164" as="geometry"/></mxCell><mxCell id="sim" value="&lt;b&gt;SimuladorRenovacao&lt;/b&gt;&lt;hr/&gt;+ janela(referencia): array&lt;br/&gt;+ avaliar(seguros, referencia): array" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf8ee;strokeColor=#2d735b;fontColor=#163e31;align=left;verticalAlign=top;spacing=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1125" y="255" width="340" height="118" as="geometry"/></mxCell><mxCell id="resultado" value="&lt;b&gt;ResultadoTriagem&lt;/b&gt;&lt;hr/&gt;- linhas: list&amp;amp;lt;LinhaResultadoTriagem&amp;amp;gt;&lt;br/&gt;+ 